{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "scofist",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "kv_namespaces": [
    {
      "binding": "NEXT_CACHE_WORKERS_KV",
      "id": "5329a217bd604ddd89c4b08cf3f775ba",
    },
  ],
  "vars": {
    "CLOUDINARY_CLOUD_NAME": "do8vcjig0",
    "COMPANY_NAME": "Scofist",
    "GOOGLE_SHEET_WEBHOOK_URL": "https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec",
    "NEXT_PUBLIC_BASE_URL": "https://scofist.com",
    "NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME": "do8vcjig0",
    "NEXT_PUBLIC_VAPID_PUBLIC_KEY": "BLaWu4kuta6MjYVB0gtvpwcXi_lIWi2AdusuLwOeLXOZKuodEJYNjWOzvFqxtXXauy2NykIozCY8cTt5WngNQOI",
    "VAPID_PUBLIC_KEY": "BLaWu4kuta6MjYVB0gtvpwcXi_lIWi2AdusuLwOeLXOZKuodEJYNjWOzvFqxtXXauy2NykIozCY8cTt5WngNQOI"
  }
}
